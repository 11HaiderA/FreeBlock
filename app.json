{
  "expo": {
    "name": "FreeBlock",
    "slug": "freeblock",
    "owner": "haiderali110s-team",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.sammad.freeblock",
      "adaptiveIcon": {
        "backgroundColor": "#221107",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "versionCode": 2
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-audio",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-8090216489030865~3376119637",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511"
        }
      ],
      "expo-asset",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 35,
            "buildToolsVersion": "36.0.0",
            "minSdkVersion": 24
          }
        }
      ],
      "./plugins/withAndroidCompileSdk"
    ],
    "extra": {
      "eas": {
        "projectId": "21edf522-18b5-4763-ae05-a0f41cdba4bf"
      }
    }
  }
}
